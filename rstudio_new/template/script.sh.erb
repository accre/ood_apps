#!/usr/bin/env bash

# Load the required environment
setup_env () {
	module purge

	accre_rversion=<%= context.version %>

	if [ "${accre_rversion}" = "custom" ]; then
		if [ -z "${context.custom_container}" ]; then
			echo "ERROR: Custom container path is required when 'custom' version is selected."
			echo "Please provide a valid path to your Singularity container."
			exit 1
		fi
		export RSTUDIO_SERVER_IMAGE="${context.custom_container}"
		export R_LIBS_USER="~/R/custom"
	else
		r_ver=$(echo "${accre_rversion}" | cut -d "-" -f 2)
		r_opt=$(echo "${accre_rversion}" | cut -d "-" -f 3)
		export RSTUDIO_SERVER_IMAGE="/labs/accre_public/singularity/RStudio/${r_ver}/R-RStudio-x86-64-${r_opt}.sif"
		export R_LIBS_USER="~/R/${r_ver}/x86_64_${r_opt}"
	fi

	if [ ! -r "${RSTUDIO_SERVER_IMAGE}" ]; then
		echo "ERROR:  Singularity container ${RSTUDIO_SERVER_IMAGE} not found."
		exit 1
	fi
}

setup_env

if [ -z "${RSTUDIO_SINGULARITY_HOST_MNT:-}" ]; then
    echo "ERROR: RSTUDIO_SINGULARITY_HOST_MNT is not set."
    echo "This variable must be provided by the cluster environment."
    exit 1
fi
export RSESSION_PATH="${RSTUDIO_SINGULARITY_HOST_MNT}${PWD}"

# Note that we intentionally do not erase these folders when complete, as
# each user job is spawned in a separate directory based on a UUID so there
# is no risk of collision/overwriting.   Preserving generated files also
# makes it easier for us to debug when things go wrong.
mkdir -p "${RSESSION_PATH}/run"
mkdir -p "${RSESSION_PATH}/var-lib-rstudio-server"
mkdir -p "${RSESSION_PATH}/etc_rstudio"

#
# Start RStudio Server
#

# PAM auth helper used by RStudio
export RSTUDIO_AUTH="${RSESSION_PATH}/bin/auth"

# Generate an `rsession` wrapper script
export RSESSION_WRAPPER_FILE="${RSESSION_PATH}/rsession.sh"
(
umask 077
sed 's/^ \{2\}//' > "${RSESSION_WRAPPER_FILE}" << EOL
  #!/usr/bin/env bash

  # Log all output from this script
  export RSESSION_LOG_FILE="${RSESSION_PATH}/rsession.log"

  exec &>>"\${RSESSION_LOG_FILE}"
  set -x

  # Construct local RStudio Server database.conf file
  printf "provider=sqlite\ndirectory=/var/lib/rstudio-server\n"  > "${RSESSION_PATH}/etc_rstudio/database.conf"

  # Construct local RStudio Server rserver.conf file
  printf 'server-user=%s\n' "${USER}"                            >  "${RSESSION_PATH}/etc_rstudio/rserver.conf"
  printf "rsession-which-r=/usr/local/bin/R\n"                   >> "${RSESSION_PATH}/etc_rstudio/rserver.conf"
  printf "rsession-ld-library-path=/usr/local/lib64/R/lib\n"     >> "${RSESSION_PATH}/etc_rstudio/rserver.conf"
  printf "www-enable-origin-check=0\n"                           >> "${RSESSION_PATH}/etc_rstudio/rserver.conf"

  # Construct local RStudio Server rsession.conf
  printf "r-libs-user=${R_LIBS_USER}\n"                          > "${RSESSION_PATH}/etc_rstudio/rsession.conf"

  # Construct local RStudio Server logging.conf (for debugging)
#  printf "[*]\nlog-level=debug\n"                               > "${RSESSION_PATH}/etc_rstudio/logging.conf"  # Only use debug when actually debugging
  printf "[*]\nlog-level=info\n"                                 > "${RSESSION_PATH}/etc_rstudio/logging.conf"

  export TZ="US/Central"

  # Launch the original command
  echo "Launching rsession..."
  set -x
  exec rsession --r-libs-user "${R_LIBS_USER}" "\${@}"
EOL
)
chmod 700 "${RSESSION_WRAPPER_FILE}"

# Set working directory to home directory
cd "${HOME}"

python3 -c 'from uuid import uuid4; print(uuid4())' > "${RSESSION_PATH}/etc_rstudio/secure-cookie-key"
chmod 0600 "${RSESSION_PATH}/etc_rstudio/secure-cookie-key"
export SECURE_COOKIE_KEY="${RSESSION_PATH}/etc_rstudio/secure-cookie-key"

set -x
# Launch the RStudio Server
echo "Starting up rserver at $(date) ..."

singularity exec \
   --bind ${RSESSION_PATH}/run:/run,${RSESSION_PATH}/var-lib-rstudio-server:/var/lib/rstudio-server,${RSESSION_PATH}/etc_rstudio:/etc/rstudio,${ACCRE_RUNTIME_DIR}:/tmp,/accre,/cvmfs,/data,/nobackup,/labs,/panfs,/v5000 \
   "${RSTUDIO_SERVER_IMAGE}" /usr/lib/rstudio-server/bin/rserver \
   --auth-encrypt-password 0 \
   --auth-none 0 \
   --auth-pam-helper-path "${RSTUDIO_AUTH}" \
   --server-user ${USER} \
   --www-port "${port}" \
   --secure-cookie-key-file "${SECURE_COOKIE_KEY}" \
   --rsession-path "${RSESSION_WRAPPER_FILE}"

echo "Finished rserver at $(date), exit code $?"
