#!/usr/bin/env bash

set -euo pipefail

# rstudio 1.4+ needs a csrf token
csrf_token=<%= SecureRandom.uuid %>

# Export the module function if it exists
[[ $(type -t module) == "function" ]] && export -f module

# Find available port to run server on
port=$(find_port ${host}) || { echo "ERROR: No available port found"; exit 1; }

# Define a password and export it for RStudio authentication
password="$(create_passwd 16)" || { echo "ERROR: No password generated"; exit 1; }
export RSTUDIO_PASSWORD="${password}"

# Set the ACCRE_RUNTIME_DIR environment variable, which is subsequently used in script.sh.erb
if [[ -r /accre/usr/bin/setup_accre_runtime_dir ]]; then
    source /accre/usr/bin/setup_accre_runtime_dir
else
    echo "ERROR: /accre/usr/bin/setup_accre_runtime_dir not found"
    exit 1
fi


### The "find_port()" and "create_passwd()" functions used above are
### externally provided by Open Ondemand and are not part of this script.
### If analyzing the source code, do not complain about them being missing.
