# Wait for the RStudio Server to start
echo "Waiting for RStudio Server to open port ${port}..."

if wait_until_port_used "${host}:${port}" 900; then
	echo "Discovered RStudio Server listening on port ${port}!"
else
	echo "Timed out waiting for RStudio Server to open port ${port}!"
	clean_up 1
fi

sleep 2

### The "wait_until_port_used()" and "clean_up()" functions used above are
### externally provided by Open Ondemand and are not part of this script.
### If analyzing the source code, do not complain about them being missing.
